# Local development environment variables
# Copy this file to .env and fill in the values.
# Do NOT commit .env to version control.

# ── Site configuration ─────────────────────────────────────────────────────
# Public site URL (used by Astro for canonical URLs and sitemap generation).
# Set this to the production URL once deployed.
SITE_URL=http://localhost:4321

# ── Cloudflare Pages deployment (CI/CD only — not needed for local dev) ───
# These are consumed by the `deploy.yml` workflow on push to main.
# Store them as GitHub Actions secrets, never commit real values here.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_PAGES_PROJECT=agile-flow-docs

# ── Error receiver (deferred — not yet wired) ─────────────────────────────
# When the error-receiver Cloudflare Worker lands, it will need a GITHUB_TOKEN
# scoped to `issues:write` on the docs repo, and the target repo identifier.
# See docs/TECHNICAL-ARCHITECTURE.md "Error Receiver" section.
# GITHUB_TOKEN=
# GITHUB_REPOSITORY=vibeacademy/agile-flow-docs

# ── Mailing list signup (deferred — pending provider selection) ───────────
# Set once a provider (ConvertKit / Buttondown / etc.) is chosen during
# the mailing-list-signup feature ticket.
# MAILING_LIST_API_KEY=
# MAILING_LIST_FORM_ID=
